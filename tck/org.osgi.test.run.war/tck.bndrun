# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	org.osgi.framework.bootdelegation="sun.*,com.sun.*",\
	org.osgi.service.webcontainer.hostname=127.0.0.1,\
	org.osgi.service.webcontainer.http.port=8080,\
	org.osgi.test.testcase.timeout=10000,\
	org.osgi.test.testcase.scaling=1

-runfw: org.eclipse.osgi

-runsystempackages: \
	com.sun.jndi.ldap,\
	com.sun.security.auth.login,\
	sun.java2d,\
	sun.misc,\
	sun.rmi.transport,\
	javax.annotation.processing,\
	javax.lang.model,\
	javax.lang.model.element,\
	javax.lang.model.type,\
	javax.lang.model.util,\
	javax.tools,\
	java.lang.instrument,\
	org.apache.xerces.impl,\
	org.apache.tools.ant,\
	org.apache.tools.ant.taskdefs,\
	org.apache.tools.ant.taskdefs.compilers,\
	org.apache.tools.ant.types,\
	org.apache.tools.ant.util,\
	org.eclipse.jdt.core.index,\
	org.eclipse.osgi.baseadaptor,\
	org.eclipse.osgi.baseadaptor.bundlefile,\
	org.eclipse.jdt.core.util,\
	org.eclipse.osgi.framework.adaptor,\
	org.eclipse.osgi.framework.internal.core

# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.webcontainer',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-activation_1.1_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-annotation_1.1_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-ejb_3.0_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-el_2.2_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-javamail_1.4_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jta_1.1_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jaxb_2.1_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jaxrpc_1.1_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-saaj_1.3_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-stax-api_1.0_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jaxws_2.1_spec',\
	bnd.identity;id='org.glassfish.hk2.external.aopalliance-repackaged',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jpa_1.0_spec',\
	bnd.identity;id='slf4j.api',\
	bnd.identity;id='slf4j.nop',\
	bnd.identity;id='org.springframework.aop',\
	bnd.identity;id='org.springframework.beans',\
	bnd.identity;id='org.springframework.context',\
	bnd.identity;id='org.springframework.core',\
	bnd.identity;id='org.apache.commons.commons-logging',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.eclipse.equinox.event',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-servlet_3.0_spec',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jsp_2.2_spec',\
	bnd.identity;id='javax.websocket',\
	bnd.identity;id='org.apache.catalina',\
	bnd.identity;id='org.apache.catalina.ha',\
	bnd.identity;id='org.apache.catalina.tribes',\
	bnd.identity;id='org.apache.coyote',\
	bnd.identity;id='org.apache.el',\
	bnd.identity;id='org.apache.jasper',\
	bnd.identity;id='org.apache.juli.extras',\
	bnd.identity;id='org.apache.tomcat.api',\
	bnd.identity;id='org.apache.tomcat.util',\
	bnd.identity;id='org.apache.tomcat.websocket',\
	bnd.identity;id='org.eclipse.gemini.web.core',\
	bnd.identity;id='org.eclipse.gemini.web.extender',\
	bnd.identity;id='org.eclipse.gemini.web.tomcat',\
	bnd.identity;id='org.eclipse.jdt.core.compiler.batch',\
	bnd.identity;id='org.eclipse.virgo.util.common',\
	bnd.identity;id='org.eclipse.virgo.util.io',\
	bnd.identity;id='org.eclipse.virgo.util.math',\
	bnd.identity;id='org.eclipse.virgo.util.osgi',\
	bnd.identity;id='org.eclipse.virgo.util.osgi.manifest',\
	bnd.identity;id='org.eclipse.virgo.util.parser.manifest',\
	bnd.identity;id='assertj-core';version='[3.23.1,3.23.2)',\
	bnd.identity;id='junit-jupiter-api';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-params';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-platform-commons';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-engine';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-launcher';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-vintage-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='org.hamcrest';version='[2.2.0,2.2.1)',\
	bnd.identity;id='org.awaitility';version='[4.2.0,4.2.1)',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.common';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit5';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit4';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.mockito.mockito-core';version='[4.6.1,4.6.2)',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='[1.12.10,1.12.11)',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='[1.12.10,1.12.11)',\
	bnd.identity;id='org.objenesis'

# Test infrastructure for the junit-platform tester — mirrors the original
# cnf/repo/osgi.tck.junit-platform lib that every TCK run carried
-runbundles.tck: \
	assertj-core;version='[3.23.1,3.23.2)',\
	junit-jupiter-api;version='[5.8.2,5.8.3)',\
	junit-jupiter-engine;version='[5.8.2,5.8.3)',\
	junit-jupiter-params;version='[5.8.2,5.8.3)',\
	junit-platform-commons;version='[1.8.2,1.8.3)',\
	junit-platform-engine;version='[1.8.2,1.8.3)',\
	junit-platform-launcher;version='[1.8.2,1.8.3)',\
	junit-vintage-engine;version='[5.8.2,5.8.3)',\
	org.hamcrest;version='[2.2.0,2.2.1)',\
	org.awaitility;version='[4.2.0,4.2.1)',\
	org.apache.servicemix.bundles.junit;version='[4.13.2.1,4.13.2.2)',\
	org.opentest4j;version='[1.2.0,1.2.1)',\
	org.osgi.test.common;version='[1.2.0,1.2.1)',\
	org.osgi.test.assertj.framework;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit5;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit4;version='[1.2.0,1.2.1)',\
	org.mockito.mockito-core;version='[4.6.1,4.6.2)',\
	net.bytebuddy.byte-buddy;version='[1.12.10,1.12.11)',\
	net.bytebuddy.byte-buddy-agent;version='[1.12.10,1.12.11)',\
	org.objenesis


# -runbundles is calculated by the bnd-resolver-maven-plugin during the run
-runbundles:
