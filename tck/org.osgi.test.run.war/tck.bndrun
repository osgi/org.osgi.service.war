	bnd.identity;id='org.apache.geronimo.specs.geronimo-stax-api_1.0_spec';version='${tck.range;${geronimo-stax-api_1.0_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jaxws_2.1_spec';version='${tck.range;${geronimo-jaxws_2.1_spec.version}}',\
	bnd.identity;id='org.glassfish.hk2.external.aopalliance-repackaged';version='${tck.range;${aopalliance-repackaged.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jpa_1.0_spec';version='${tck.range;${geronimo-jpa_1.0_spec.version}}',\
	bnd.identity;id='slf4j.api';version='${tck.range;${slf4j.version}}',\
	bnd.identity;id='slf4j.nop';version='${tck.range;${slf4j-nop.version}}',\
	bnd.identity;id='org.springframework.aop';version='${tck.range;${spring-aop.version}}',\
	bnd.identity;id='org.springframework.beans';version='${tck.range;${spring-beans.version}}',\
	bnd.identity;id='org.springframework.context';version='${tck.range;${spring-context.version}}',\
	bnd.identity;id='org.springframework.core';version='${tck.range;${spring-core.version}}',\
	bnd.identity;id='org.apache.commons.commons-logging';version='${tck.range;${commons-logging.version}}',\
	bnd.identity;id='org.apache.felix.configadmin';version='${tck.range;${org.apache.felix.configadmin.version}}',\
