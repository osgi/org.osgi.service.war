	bnd.identity;id='org.apache.geronimo.specs.geronimo-servlet_3.0_spec';version='${tck.range;${geronimo-servlet_3.0_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jsp_2.2_spec';version='${tck.range;${geronimo-jsp_2.2_spec.version}}',\
	bnd.identity;id='javax.websocket',\
	bnd.identity;id='org.apache.catalina',\
	bnd.identity;id='org.apache.catalina.ha',\
	bnd.identity;id='org.apache.catalina.tribes',\
	bnd.identity;id='org.apache.coyote',\
	bnd.identity;id='org.apache.el',\
	bnd.identity;id='org.apache.jasper',\
	bnd.identity;id='org.apache.juli.extras',\
	bnd.identity;id='org.apache.tomcat.api',\
	bnd.identity;id='org.apache.tomcat.util',\
	bnd.identity;id='org.apache.tomcat.websocket',\
	bnd.identity;id='org.eclipse.gemini.web.core',\
	bnd.identity;id='org.eclipse.gemini.web.extender',\
	bnd.identity;id='org.eclipse.gemini.web.tomcat',\
	bnd.identity;id='org.eclipse.jdt.core.compiler.batch',\
