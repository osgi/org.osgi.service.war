# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	org.osgi.framework.bootdelegation="sun.*,com.sun.*",\
	org.osgi.service.webcontainer.hostname=127.0.0.1,\
	org.osgi.service.webcontainer.http.port=8080,\
	org.osgi.test.testcase.timeout=10000,\
	org.osgi.test.testcase.scaling=1

-runfw: org.eclipse.osgi

-runsystempackages: \
	com.sun.jndi.ldap,\
	com.sun.security.auth.login,\
	sun.java2d,\
	sun.misc,\
	sun.rmi.transport,\
	javax.annotation.processing,\
	javax.lang.model,\
	javax.lang.model.element,\
	javax.lang.model.type,\
	javax.lang.model.util,\
	javax.tools,\
	java.lang.instrument,\
	org.apache.xerces.impl,\
	org.apache.tools.ant,\
	org.apache.tools.ant.taskdefs,\
	org.apache.tools.ant.taskdefs.compilers,\
	org.apache.tools.ant.types,\
	org.apache.tools.ant.util,\
	org.eclipse.jdt.core.index,\
	org.eclipse.osgi.baseadaptor,\
	org.eclipse.osgi.baseadaptor.bundlefile,\
	org.eclipse.jdt.core.util,\
	org.eclipse.osgi.framework.adaptor,\
	org.eclipse.osgi.framework.internal.core

# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

# Test runtime versions: the Maven properties of tck/pom.xml, as the OSGi
# range [x.y.z,x.y.z+1). version_cleanup turns 1.4.0-SNAPSHOT into 1.4.0.SNAPSHOT.
tck.range: ${range;[===,==+);${version_cleanup;${1}}}

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.webcontainer';version='${tck.range;${revision}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-activation_1.1_spec';version='${tck.range;${geronimo-activation_1.1_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-annotation_1.1_spec';version='${tck.range;${geronimo-annotation_1.1_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-ejb_3.0_spec';version='${tck.range;${geronimo-ejb_3.0_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-el_2.2_spec';version='${tck.range;${geronimo-el_2.2_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-javamail_1.4_spec';version='${tck.range;${geronimo-javamail_1.4_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jta_1.1_spec';version='${tck.range;${geronimo-jta_1.1_spec.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-jaxb_2.1_spec';version='${tck.range;${geronimo-jaxb_2.1_spec.version}}',\
