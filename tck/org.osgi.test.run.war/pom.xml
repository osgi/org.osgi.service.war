	<properties>
		<!-- The keystore of the secure suites, as an absolute path. The test VM
		     runs from a working directory below target/, so a path relative to
		     this module would not resolve there; the workspace build likewise
		     hands the framework an absolute path. -->
		<tck.keystore>${project.basedir}/../keystore</tck.keystore>
	</properties>

