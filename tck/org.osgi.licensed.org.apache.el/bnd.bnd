# Third-party bundle without its own source code: the original ships it as
# a ready-made jar (licensed/repo) that moved into this module via
# keepPaths/moves. bnd repackages it here unchanged (-includeresource: @jar)
# into a bundle artifact with an explicit BSN/version, instead of placing
# the jar into the local repository by hand.
-includeresource: @org.apache.el-7.0.61.jar
-fixupmessages: "Split package*"
Bundle-SymbolicName: org.apache.el
Bundle-Version: 7.0.61
Export-Package: org.apache.el;version="7.0.61";uses:="javax.el,org.apache.el.parser",org.apache.el.lang;version="7.0.61";uses:="javax.el,org.apache.el.parser",org.apache.el.parser;version="7.0.61";uses:="javax.el,org.apache.el.lang",org.apache.el.util;version="7.0.61";uses:="javax.el"
Import-Package: javax.el;version="[1.0.0, 3.0.0)"
-noextraheaders: true
