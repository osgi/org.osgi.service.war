# Third-party bundle without its own source code: the original ships it as
# a ready-made jar (licensed/repo) that moved into this module via
# keepPaths/moves. bnd repackages it here unchanged (-includeresource: @jar)
# into a bundle artifact with an explicit BSN/version, instead of placing
# the jar into the local repository by hand.
-includeresource: @org.eclipse.gemini.web.extender-2.2.7.jar
-fixupmessages: "Split package*"
Bundle-SymbolicName: org.eclipse.gemini.web.extender
Bundle-Version: 2.2.7.RELEASE
Bundle-Activator: org.eclipse.gemini.web.extender.ExtenderActivator
Export-Package: org.eclipse.gemini.web.extender;version="2.2.7.RELEASE";uses:="org.eclipse.gemini.web.core,org.osgi.framework,org.osgi.util.tracker"
Import-Package: org.eclipse.gemini.web.core;version="2.2.7",org.osgi.framework;version="0",org.osgi.util.tracker;version="0",org.slf4j;version="[1.7.2,1.8)"
-noextraheaders: true
