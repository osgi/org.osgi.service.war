# Third-party bundle without its own source code: the original ships it as
# a ready-made jar (licensed/repo) that moved into this module via
# keepPaths/moves. bnd repackages it here unchanged (-includeresource: @jar)
# into a bundle artifact with an explicit BSN/version, instead of placing
# the jar into the local repository by hand.
-includeresource: @org.apache.tomcat.util-7.0.61.jar
-fixupmessages: "Split package*"
Bundle-SymbolicName: org.apache.tomcat.util
Bundle-Version: 7.0.61
Export-Package: org.apache.tomcat.util.descriptor;version="7.0.61";uses:="org.apache.juli.logging,org.apache.tomcat.util.digester,org.xml.sax,org.xml.sax.ext",org.apache.tomcat.util.file;version="7.0.61",org.apache.tomcat.util.res;version="7.0.61",org.apache.tomcat.util.scan;version="7.0.61";uses:="javax.servlet,org.apache.tomcat",org.apache.tomcat.util.security;version="7.0.61"
Import-Package: javax.servlet;version="[2.6.0, 4.0.0)",org.apache.juli.logging;version="[7.0.61, 7.0.62)",org.apache.tomcat;version="[7.0.61, 7.0.62)",org.apache.tomcat.util.digester;version="[7.0.61, 7.0.62)",org.xml.sax;version="0",org.xml.sax.ext;version="0"
-noextraheaders: true
