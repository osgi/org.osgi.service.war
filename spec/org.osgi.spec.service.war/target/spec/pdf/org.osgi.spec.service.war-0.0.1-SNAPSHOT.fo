                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The package dependencies for the clients of this specification are
      listed in the following table.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d63e181">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 128.1</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Dependency versions</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(3)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1.5)"/>
                     <fo:table-column column-number="3" column-width="proportional-column-width(3)"/>
                     <fo:table-header start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always"
                                      keep-with-next.within-column="always"
                                      font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Packages</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Export Version</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Client Import Range</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">javax.servlet</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">2.5</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">[2.5,3.0)</fo:inline>
                              </fo:block>
                           </fo:table-cell>
